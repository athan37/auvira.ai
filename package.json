{
  "name": "ai-website-migration-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:all": "npm run test && npm run test:llm",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/website-agent-v2/websiteAgentV2.siteModel.integration.test.ts",
    "test:llm": "VITEST_LLM_SUITE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/website-agent-v2/planEdit.llm.test.ts tests/website-agent-v2/e2e.llm.test.ts tests/website-agent-v2/sectionPresentation.llm.test.ts tests/integration/website-agent-v2/websiteAgentV2.plan.integration.test.ts tests/integration/website-agent-v2/websiteAgentV2.clarification.integration.test.ts tests/integration/website-edit-agent/sectionStylePreviewSync.integration.test.ts tests/integration/website-edit-agent/chatHistoryEdit.llm.test.ts",
    "test:contracts": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/project-workspace/sectionColorEdit.contract.test.ts tests/project-workspace/sectionColorEdit.jobberRegression.test.ts tests/builder/tailwindConfigCoversClass.test.ts tests/builder/tailwindBackgroundResolver.test.ts tests/builder/sectionPresentation.test.ts tests/website-edit-agent/editJobClassifier.test.ts tests/website-edit-agent/siteSectionCatalog.test.ts tests/website-edit-agent/buildGroundedEditContext.test.ts tests/website-edit-agent/enrichEditPrompt.test.ts tests/website-edit-agent/sectionStyleStrategy.infraReady.test.ts tests/website-edit-agent/sectionStyleStrategy.legacy.test.ts tests/project-workspace/sectionStyleLegacyPreview.e2e.test.ts",
    "test:section-color": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/project-workspace/sectionColorEdit.contract.test.ts tests/project-workspace/sectionColorEdit.jobberRegression.test.ts tests/website-edit-agent/sectionStyleStrategy.legacy.test.ts tests/website-edit-agent/sectionStyleStrategy.infraReady.test.ts tests/sandbox/validateSandboxWorkspace.test.ts",
    "test:llm:contracts": "VITEST_LLM_SUITE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/agentContracts/sectionColorEdit.llm.test.ts",
    "test:llm:section-catalog": "VITEST_LLM_SUITE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/website-edit-agent/sectionCatalogHard.llm.test.ts",
    "test:llm:presentation": "VITEST_LLM_SUITE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/website-agent-v2/sectionPresentation.llm.test.ts",
    "test:scratch-live": "tsx scripts/test-scratch-workflow-live.ts",
    "test:diff-local": "node --env-file=.env -e \"require('child_process').execSync('npx --yes tsx scripts/test-diff-api-local.ts', {stdio:'inherit'})\"",
    "test:build-gate-local": "node --env-file=.env -e \"require('child_process').execSync('npx --yes tsx scripts/test-build-gate-local.ts', {stdio:'inherit'})\"",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "build:clean": "npm run clean && npm run build",
    "dev:wait": "sh scripts/wait-for-dev.sh"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.2",
    "@types/cheerio": "^0.22.35",
    "@types/puppeteer": "^5.4.7",
    "@vercel/sandbox": "^2.0.0",
    "ajv": "^8.17.1",
    "cheerio": "^0.22.0",
    "diff": "^5.2.0",
    "mongoose": "^7.8.9",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.31",
    "puppeteer": "^24.43.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
