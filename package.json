{
  "name": "ai-website-migration-agent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scratch-live": "tsx scripts/test-scratch-workflow-live.ts",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "build:clean": "npm run clean && npm run build",
    "dev:wait": "sh scripts/wait-for-dev.sh"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "@auth/mongodb-adapter": "^3.11.2",
    "@types/cheerio": "^0.22.35",
    "@types/puppeteer": "^5.4.7",
    "cheerio": "^0.22.0",
    "mongoose": "^7.8.9",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.31",
    "puppeteer": "^24.43.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
