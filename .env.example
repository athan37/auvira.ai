# LLM: minimax (direct API, default) | minimax-proxy (local :3457) | gemini
LLM_PROVIDER=minimax
MINIMAX_API_KEY=sk-cp-your-key
MINIMAX_API_URL=https://api.minimax.io/anthropic/v1/messages
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Optional image API (not used by website edit agent)
MINIMAX_IMAGE_KEY=
MINIMAX_IMAGE_API_URL=https://api.minimax.io/v1/image_generation

# Legacy local proxy (only if LLM_PROVIDER=minimax-proxy)
MINIMAX_PROXY_URL=http://localhost:3457/minimax-json

# Website edit agent: V3 only (GitLab workspaces required)
# Tests: npm test = unit only (~5s default timeout). Live LLM: npm run test:llm (needs MINIMAX_API_KEY in local .env — see AGENTS.md)
# VITEST_LLM_RETRY=2            # retries per failed LLM test when using test:llm* (default 2)
# npm run test:all              # unit + LLM
# npm run test:llm:presentation # section presentation LLM suite only

# Owner project edits — tiered router (L0 deterministic + single-shot + agent loop)
# WEBSITE_EDIT_MAX_TOKENS=4096
# WEBSITE_EDIT_UNIFIED_COPY=1   # unified config copy resolver (default on; set 0 for legacy heuristics)

# Owner project edits — Website Edit Agent V3 (GitLab workspaces required)

# Optional: use Gemini for the agent tool loop only (if MiniMax JSON is flaky)
# WEBSITE_EDIT_LLM_PROVIDER=gemini

# Site Monitor observability sidecar (la-mue-site-monitor on Railway)
# Site Monitor observability (on by default when OBSERVABILITY_API_KEY is set; set ENABLED=0 to opt out)
# OBSERVABILITY_ENABLED=1
# OBSERVABILITY_COACHING_ENABLED=1
# OBSERVABILITY_API_URL=https://la-mue-site-monitor-production.up.railway.app
# OBSERVABILITY_TENANT_ID=la-mue
# OBSERVABILITY_API_KEY=
# OBSERVABILITY_TIMEOUT_MS=5000
# PHOENIX_APP_URL=https://app.phoenix.arize.com
# PHOENIX_TRACE_URL_TEMPLATE=https://app.phoenix.arize.com/traces/{traceId}
# NEXT_PUBLIC_OBSERVABILITY_DEBUG=1
# NEXT_PUBLIC_PHOENIX_APP_URL=https://app.phoenix.arize.com

# MongoDB (required for auth)
MONGODB_URI=mongodb://localhost:27017/ai-website-migration

# NextAuth (required for auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Auth.js v5: AUTH_SECRET preferred; NEXTAUTH_SECRET still supported
AUTH_SECRET=your-auth-secret-min-32-chars
# NEXTAUTH_SECRET=same-value-as-above-if-you-prefer-legacy-name
# Local dev only (optional on Vercel — Auth.js auto-detects host when VERCEL=1):
NEXTAUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# Dev only: skip owner auth for project APIs + editor page (never enable in production)
# SITE_AGENT_DEV_BYPASS_AUTH=1
# NEXT_PUBLIC_SITE_AGENT_DEV_BYPASS_AUTH=1
# Optional: Mongo user _id for curl/E2E scripts (defaults to oldest user in DB)
# SITE_AGENT_DEV_BYPASS_USER_ID=

GITLAB_TOKEN=glpat-your-gitlab-token
GITLAB_GROUP_ID=your-gitlab-group-id
GITLAB_BASE_URL=https://gitlab.com/api/v4

# Optional: deploy customer sites via Vercel API (not required to host this app on Vercel).
# Use SITE_AGENT_VERCEL_* — do not use VERCEL_TOKEN or VERCEL_API_TOKEN in the Vercel dashboard (reserved).
SITE_AGENT_VERCEL_TOKEN=
SITE_AGENT_VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=site-agent

# Optional override; on Vercel, next.config sets this from VERCEL_URL at build time:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scratch workspace TTL (ms). Default 1800000 (30 min). Released on editor leave + pruned on bootstrap.
# SITE_AGENT_SCRATCH_DIR=/custom/scratch/path
# SITE_AGENT_SCRATCH_TTL_MS=1800000

# Build gate: npm install + next build in temp dir. Off on Vercel serverless by default.
# SITE_AGENT_RUN_BUILD_GATE=1
# SITE_AGENT_SKIP_BUILD_GATE=1

# Vercel Sandbox dev preview (when VERCEL=1): git clone + npm run dev in an isolated VM.
# Auth: OIDC on Vercel deployments (recommended) or token from `vercel env pull` locally.
# VERCEL_SANDBOX_TOKEN=
# SITE_AGENT_SANDBOX_TIMEOUT=30m
# SITE_AGENT_SANDBOX_ENABLED=0